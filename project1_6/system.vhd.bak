library ieee;
use ieee.std_logic_1164.all;

entity system is
port(
	sel1 : in std_logic;
	sel2 : in std_logic;
	con0 : in std_logic_vector(1 downto 0);
	con1 : in std_logic_vector(1 downto 0);
	con2 : in std_logic_vector(1 downto 0);
	con3 : in std_logic_vector(1 downto 0);
	HEX0 : out std_logic_vector(6 downto 0)
);
end system;

architecture behavior of system is
	component seven_segment is
	port(
		c0, c1: in std_logic;
		H_out : out std_logic_vector(6 downto 0)
	);
	end component;
	
	component Mux4x1 is
	port(
		x, y, z, w : in std_logic_vector(1 downto 0);
		mo : out std_logic_vector(1 downto 0);
		s1, s2 : in std_logic
	);
	end component;
	
	signal m_int : std_logic_vector(1 downto 0);
	signal m_final : std_logic_vector(1 downto 0);

begin
	U1 : Mux4x1 port map (x => con0, y => con1, z => con2, w => con3, s1 => sel1, s2 => sel2, mo => m_int);
	m_final(0) <= m_int(0) xor sel1;
	m_final(1) <= m_int(1) xor sel2 xor (m_int(0) and sel1);
	U2 : seven_segment port map (c0 => m_final(0), c1 => m_final(1), H_out => HEX0);
end behavior;

library ieee;
use ieee.std_logic_1164.all;

entity seven_segment is
port(
	c0 : in std_logic;
	c1 : in std_logic;
	H_out : out std_logic_vector(6 downto 0)
);
end seven_segment;

architecture behavioral of seven_segment is

begin
	H_out(0) <= not c0;
	H_out(1) <= c0;
	H_out(2) <= c0;
	H_out(3) <= c1;
	H_out(4) <= c1;
	H_out(5) <= not c0;
	H_out(6) <= c1;
end behavioral;

library ieee;
use ieee.std_logic_1164.all;

entity Mux4x1 is
port(
	x : in std_logic_vector(1 downto 0);
	y : in std_logic_vector(1 downto 0);
	z : in std_logic_vector(1 downto 0);
	w : in std_logic_vector(1 downto 0);
	s1: in std_logic;
	s2: in std_logic;
	mo: out std_logic_vector(1 downto 0)
);
end Mux4x1;

architecture behavior of Mux4x1 is
	
	component Mux2x1 is
	port(
		a, b : in std_logic_vector(1 downto 0);
		s : in std_logic;
		m : out std_logic_vector(1 downto 0)
	);
	end component;
	signal m1_out, m2_out : std_logic_vector(1 downto 0);

begin
	U1: Mux2x1 port map (a => x, b => y, s => s1, m => m1_out);
	U2: Mux2x1 port map (a => z, b => w, s => s1, m => m2_out);
	U3: Mux2x1 port map (a => m1_out, b => m2_out, s => s2, m => mo);
end behavior;

library ieee;
use ieee.std_logic_1164.all;

entity Mux2x1 is
port(
	a : in std_logic_vector(1 downto 0);
	b : in std_logic_vector(1 downto 0);
	s : in std_logic;
	m : out std_logic_vector(1 downto 0)
);
end Mux2x1;

architecture behavior of Mux2x1 is
	signal s_vector : std_logic_vector(1 downto 0);
	signal not_s_vector : std_logic_vector(1 downto 0);
	signal int1 : std_logic_vector(1 downto 0);
	signal int2 : std_logic_vector(1 downto 0);
	
	begin
		s_vector <= (others => s);
		not_s_vector <= (others => not s);
		int1 <= a and not_s_vector;
		int2 <= b and s_vector;
		m <= int1 or int2;
	end behavior;